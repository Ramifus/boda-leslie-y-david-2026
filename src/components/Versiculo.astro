---
// src/components/Versiculo.astro
// Recuadro bordó con la frase en Cinzel blanca y los anillos dorados
// debajo. La misma flor colgante (florabajo.png) pisa dos esquinas: arriba
// a la izquierda y abajo a la derecha.

// ── DATOS EDITABLES ───────────────────────────────────────────
const frase =
    "Entre todas las historias del mundo, escribiremos la nuestra… y queremos compartir contigo su primer capítulo.";
// ──────────────────────────────────────────────────────────────
---

<section id="versiculo" class="seccion">
    <div id="caja-versiculo" class="caja">
        <p class="texto">{frase}</p>

        <!-- Anillos -->
        <svg class="anillos" viewBox="0 0 64 44" aria-hidden="true">
            <defs>
                <linearGradient id="oro-versiculo" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#f3dc9a"></stop>
                    <stop offset="50%" stop-color="#c9a24e"></stop>
                    <stop offset="100%" stop-color="#8f6a26"></stop>
                </linearGradient>
            </defs>
            <circle
                cx="24"
                cy="26"
                r="14"
                fill="none"
                stroke="url(#oro-versiculo)"
                stroke-width="3.4"></circle>
            <circle
                cx="40"
                cy="26"
                r="14"
                fill="none"
                stroke="url(#oro-versiculo)"
                stroke-width="3.4"></circle>
            <path
                d="M36 9 L40 4 L44 9 L40 12 Z"
                fill="#f6f1e4"
                stroke="#c9a24e"
                stroke-width="1"></path>
        </svg>

        <!-- La misma flor en dos esquinas -->
        <img
            src="/imagenes/florabajo.png"
            alt=""
            width="828"
            height="1476"
            aria-hidden="true"
            class="flor flor-arriba"
        />
        <img
            src="/imagenes/florabajo.png"
            alt=""
            width="828"
            height="1476"
            aria-hidden="true"
            class="flor flor-abajo"
        />
    </div>
</section>

<style>
    .seccion {
        position: relative;
        width: 100%;
        padding: 12% 0 10%;
    }

    /* Las letras se miden contra el recuadro, no contra la pantalla */
    .caja {
        container-type: inline-size;
        position: relative;
        width: 90%;
        margin: 0 auto;
        padding: 12cqw 9cqw 9cqw;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        /* Como imagen y no como color: el modo oscuro forzado la respeta */
        background-image:
            radial-gradient(
                ellipse at 50% 30%,
                rgba(255, 255, 255, 0.06) 0%,
                rgba(255, 255, 255, 0) 65%
            ),
            linear-gradient(180deg, #7a2335 0%, #6f1f30 100%);
        box-shadow: 0 10px 24px rgba(70, 20, 30, 0.22);
    }

    .texto {
        position: relative;
        z-index: 1;
        margin: 0;
        font-family: "Cinzel", serif;
        font-weight: 400;
        font-size: 5.4cqw;
        line-height: 1.35;
        letter-spacing: 0.04em;
        color: #f7f1e8;
    }

    .anillos {
        position: relative;
        z-index: 1;
        display: block;
        width: 17cqw;
        height: auto;
        margin-top: 9cqw;
        filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
    }

    .flor {
        position: absolute;
        z-index: 2;
        width: 16cqw;
        height: auto;
        pointer-events: none;
        user-select: none;
        filter: drop-shadow(0 3px 5px rgba(0, 0, 0, 0.2));
    }

    /* Cuelga desde la esquina de arriba a la izquierda */
    .flor-arriba {
        top: -9cqw;
        left: -5cqw;
    }

    /* Cuelga desde la esquina de abajo a la derecha, pisando el borde */
    .flor-abajo {
        right: -5cqw;
        bottom: -17cqw;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const caja = document.getElementById("caja-versiculo");
        if (!caja) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        const texto = caja.querySelector(".texto");
        const anillos = caja.querySelector(".anillos");
        const flores = caja.querySelectorAll(".flor");

        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: caja,
                start: "top 85%",
                toggleActions: "play none none reset",
            },
        });

        tl.fromTo(
            caja,
            { opacity: 0, y: 24 },
            { opacity: 1, y: 0, duration: 1, ease: "power2.out" },
        )
            .fromTo(
                texto,
                { opacity: 0, y: 12 },
                { opacity: 1, y: 0, duration: 0.9, ease: "power2.out" },
                0.35,
            )
            .fromTo(
                anillos,
                { opacity: 0, scale: 0.8 },
                { opacity: 1, scale: 1, duration: 0.8, ease: "back.out(1.8)" },
                0.8,
            )
            .fromTo(
                flores,
                { opacity: 0, rotate: -8, transformOrigin: "50% 0%" },
                {
                    opacity: 1,
                    rotate: 0,
                    duration: 1.1,
                    stagger: 0.2,
                    ease: "power2.out",
                },
                0.5,
            );
    });
</script>
