---
// src/components/SugerenciaRegalo.astro
// "Sugerencia de Regalo" en Great Vibes bordó, el aviso en Cinzel y las
// dos opciones con su dibujo de línea: lluvia de sobres (sobre2.png) y
// mesa de regalos (regalo.png), con el botón para ver la mesa.

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Sugerencia de Regalo";
const aviso =
    "¡Tu presencia es nuestro mejor regalo! Pero si deseas obsequiarnos algo puedes hacerlo de la siguiente manera:";
const opcionSobres = "Lluvia de sobres";
const opcionMesa = "Mesa de regalos";
const textoBoton = "Ver Mesa";
// FALTA: el link de la mesa de regalos. Se abre en otra pestaña, así el
// invitado no pierde la invitación.
const linkMesa = "#";
// ──────────────────────────────────────────────────────────────
---

<section id="sugerencia-regalo" class="seccion">
    <p class="titulo font-great-vibes">{titulo}</p>
    <p class="aviso">{aviso}</p>

    <div class="opcion">
        <p class="rotulo">{opcionSobres}</p>
        <img
            src="/imagenes/sobre2.png"
            alt=""
            width="799"
            height="520"
            aria-hidden="true"
            class="dibujo dibujo-sobre"
        />
    </div>

    <div class="opcion">
        <p class="rotulo">{opcionMesa}</p>
        <img
            src="/imagenes/regalo.png"
            alt=""
            width="661"
            height="804"
            aria-hidden="true"
            class="dibujo dibujo-regalo"
        />
    </div>

    <a href={linkMesa} target="_blank" rel="noopener" class="boton"
        >{textoBoton}</a
    >
</section>

<style>
    .seccion {
        /* Las letras se miden contra el ancho de la sección */
        container-type: inline-size;
        position: relative;
        width: 100%;
        padding: 8cqw 5cqw 12cqw;
        text-align: center;
    }

    .titulo {
        margin: 0;
        color: #7a2335;
        font-size: 12cqw;
        line-height: 1.15;
    }

    .aviso {
        margin: 3cqw auto 0;
        font-family: "Cinzel", serif;
        font-size: 4.4cqw;
        line-height: 1.3;
        letter-spacing: 0.02em;
        color: #7a2335;
    }

    .opcion {
        margin-top: 8cqw;
    }

    .rotulo {
        margin: 0;
        font-family: "Cinzel", serif;
        font-weight: 700;
        font-size: 4.8cqw;
        letter-spacing: 0.03em;
        color: #6a1e2e;
    }

    .dibujo {
        display: block;
        height: auto;
        margin: 5cqw auto 0;
        user-select: none;
        -webkit-user-drag: none;
    }

    .dibujo-sobre {
        width: 25cqw;
    }

    .dibujo-regalo {
        width: 25cqw;
    }

    .boton {
        display: inline-block;
        margin-top: 12cqw;
        padding: 1.8cqw 7.4cqw;
        border-radius: 999px;
        font-family: "Cinzel", serif;
        font-size: 4.2cqw;
        letter-spacing: 0.04em;
        text-decoration: none;
        color: #f7f2e6;
        /* Como imagen y no como color: el modo oscuro forzado la respeta */
        background-image: linear-gradient(#7a2335, #6f1f30);
        box-shadow: 0 4px 10px rgba(70, 20, 30, 0.25);
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("sugerencia-regalo");
        if (!seccion) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        // Encabezado: entra apenas se asoma la sección
        gsap.fromTo(
            seccion.querySelectorAll(".titulo, .aviso"),
            { opacity: 0, y: 14 },
            {
                opacity: 1,
                y: 0,
                duration: 0.9,
                stagger: 0.2,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: seccion,
                    start: "top 80%",
                    toggleActions: "play none none reset",
                },
            },
        );

        // Cada opción y el botón entran cuando llegan a la pantalla: la
        // sección es alta y con un solo disparador ya habrían terminado
        seccion.querySelectorAll(".opcion, .boton").forEach((el) => {
            gsap.fromTo(
                el,
                { opacity: 0, y: 20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.9,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: el,
                        start: "top 88%",
                        toggleActions: "play none none reset",
                    },
                },
            );
        });
    });
</script>
