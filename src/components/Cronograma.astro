---
// src/components/Cronograma.astro
// "Cronograma" y, debajo, la línea de tiempo del día: un eje dorado fino
// en el centro que se va llenando de luz a medida que se baja, un rombo
// por momento que se enciende al pasar, y a cada lado, alternando, el
// arco con el ícono y la hora con el nombre.
//
// ── Cómo está armado ─────────────────────────────────────────
// Cada momento es una fila de tres columnas: lado izquierdo, eje, lado
// derecho. En los pares el arco va a la derecha y la hora a la izquierda;
// en los impares al revés. Las filas tienen alto propio, así que nada se
// encima aunque un nombre baje de renglón.
//
// ── Letras y colores ─────────────────────────────────────────
// Los mismos del resto de la invitación: título y nombres en Great Vibes
// bordó, horas en Cormorant Garamond fina con el "P.M." en Cinzel dorado.
// Los íconos se pintan con máscara del mismo bordó del título.
//
// Todo se mide contra el ancho de la columna: 1cqw = 1% de ese ancho.

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Cronograma";
const subtitulo = "Nuestro gran día";

/*
   El orden manda: el primero lleva el arco a la derecha, el segundo a la
   izquierda, y así alternando. No hace falta indicar el lado.

   Los íconos salen de /imagenes/iconos, uno por momento.

   La hora se escribe "4:00 P.M.": lo de antes del espacio va grande y lo
   de después chiquito y dorado. Si un momento va sin hora, hora: "".
*/
const momentos = [
    { nombre: "Recepción", hora: "4:00 P.M.", icono: "recepcion.png" },
    { nombre: "Religiosa", hora: "5:00 P.M.", icono: "ceremoniareligiosa.png" },
    { nombre: "Civil", hora: "8:00 P.M.", icono: "ceremoniacivil.png" },
    { nombre: "Primer Baile", hora: "8:40 P.M.", icono: "baile.png" },
    { nombre: "Cena", hora: "9:00 P.M.", icono: "cena.png" },
    { nombre: "Torta", hora: "10:00 P.M.", icono: "torta.png" },
    { nombre: "Celebración", hora: "10:30 P.M.", icono: "celebracion.png" },
];
// ──────────────────────────────────────────────────────────────

function partirHora(hora: string) {
    const espacio = hora.indexOf(" ");
    if (espacio === -1) return { numero: hora, sufijo: "" };
    return { numero: hora.slice(0, espacio), sufijo: hora.slice(espacio + 1) };
}
---

<section id="cronograma" class="seccion">
    <p class="subtitulo">{subtitulo}</p>
    <p class="titulo font-great-vibes">{titulo}</p>
    <img
        src="/imagenes/separador.png"
        alt=""
        width="963"
        height="64"
        aria-hidden="true"
        class="separador"
    />

    <div id="linea-tiempo" class="linea">
        <!-- El eje: una base apenas marcada y la luz que la va llenando -->
        <span class="eje" aria-hidden="true">
            <span class="eje-luz"></span>
        </span>

        {
            momentos.map((momento, i) => {
                const { numero, sufijo } = partirHora(momento.hora);
                return (
                    <div class={`momento ${i % 2 === 0 ? "der" : "izq"}`}>
                        <div class="lado lado-texto">
                            {momento.hora && (
                                <p class="hora">
                                    <span class="hora-num">{numero}</span>
                                    {sufijo && (
                                        <span class="hora-suf">{sufijo}</span>
                                    )}
                                </p>
                            )}
                            <span class="filete" aria-hidden="true" />
                            <p class="nombre font-great-vibes">
                                {momento.nombre}
                            </p>
                        </div>

                        <div class="centro" aria-hidden="true">
                            <span class="rombo" />
                        </div>

                        <div class="lado lado-arco" aria-hidden="true">
                            <span class="arco">
                                <span
                                    class="icono"
                                    style={`--ic: url("/imagenes/iconos/${momento.icono}")`}
                                />
                                <span class="brillo" />
                            </span>
                        </div>
                    </div>
                );
            })
        }

        <!-- Remate al pie del eje -->
        <span class="remate" aria-hidden="true"></span>
    </div>
</section>

<style>
    .seccion {
        container-type: inline-size;
        position: relative;
        width: 100%;
        padding: 9cqw 0 10cqw;
        text-align: center;
    }

    .subtitulo {
        margin: 0;
        font-family: "Cinzel", serif;
        font-weight: 400;
        font-size: 2.7cqw;
        letter-spacing: 0.32em;
        text-transform: uppercase;
        color: #b08a3e;
    }

    .titulo {
        margin: 1cqw 0 0;
        color: #7a2335;
        font-size: 13cqw;
        line-height: 1.1;
    }

    .separador {
        display: block;
        width: 56cqw;
        height: auto;
        margin: 1.5cqw auto 0;
        opacity: 0.9;
    }

    .linea {
        position: relative;
        width: 100%;
        padding: 12cqw 0 14cqw;
    }

    /* Centrado con margen y no con translate: GSAP reescribe el
       transform entero al animar la escala */
    .eje {
        position: absolute;
        top: 4cqw;
        bottom: 6cqw;
        left: 50%;
        width: 1px;
        margin-left: -0.5px;
        background-image: linear-gradient(
            180deg,
            rgba(176, 138, 62, 0) 0%,
            rgba(176, 138, 62, 0.28) 6%,
            rgba(176, 138, 62, 0.28) 94%,
            rgba(176, 138, 62, 0) 100%
        );
    }

    .eje-luz {
        position: absolute;
        inset: 0 -0.5px;
        transform-origin: 50% 0%;
        background-image: linear-gradient(
            180deg,
            rgba(176, 138, 62, 0) 0%,
            #c9a55a 6%,
            #7a2335 55%,
            #b08a3e 94%,
            rgba(176, 138, 62, 0) 100%
        );
        box-shadow: 0 0 6px rgba(201, 165, 90, 0.55);
    }

    /* ── Cada momento: lado · eje · lado ───────────────────────── */
    .momento {
        position: relative;
        display: grid;
        grid-template-columns: 1fr 10cqw 1fr;
        padding: 0 5cqw;
        align-items: center;
        min-height: 27cqw;
    }

    /* En los impares se dan vuelta los lados */
    .der .lado-texto {
        grid-column: 1;
        grid-row: 1;
        text-align: right;
        padding-right: 1cqw;
    }

    .der .lado-arco {
        grid-column: 3;
        grid-row: 1;
        justify-content: flex-start;
        padding-left: 3cqw;
    }

    .izq .lado-texto {
        grid-column: 3;
        grid-row: 1;
        text-align: left;
        padding-left: 1cqw;
    }

    .izq .lado-arco {
        grid-column: 1;
        grid-row: 1;
        justify-content: flex-end;
        padding-right: 3cqw;
    }

    .centro {
        grid-column: 2;
        grid-row: 1;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
    }

    /* El rombo: filete dorado, centro claro y un halo que late al
       encenderse. Girado desde GSAP para no pisar el transform. */
    .rombo {
        display: block;
        width: 2.4cqw;
        height: 2.4cqw;
        transform: rotate(45deg);
        box-sizing: border-box;
        border: 1px solid #b08a3e;
        background-image: linear-gradient(
            135deg,
            #fffaf0 0%,
            #f1e2c2 100%
        );
        box-shadow:
            0 0 0 1cqw rgba(176, 138, 62, 0.08),
            0 0 8px rgba(201, 165, 90, 0.35);
    }

    /* ── El arco con el ícono ──────────────────────────────────── */
    .lado-arco {
        display: flex;
        align-items: center;
    }

    /* Círculo blanco con filete dorado afuera y otro adentro */
    .arco {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        width: 17cqw;
        height: 17cqw;
        border-radius: 50%;
        /* Filete dorado afuera y un hilo crema adentro, como las
           tarjetas de ceremonia y recepción */
        box-shadow:
            0 0 0 1px rgba(201, 165, 90, 0.9),
            0 0 0 0.9cqw #ffffff,
            0 0 0 calc(0.9cqw + 1px) rgba(201, 165, 90, 0.45),
            0 6px 16px rgba(122, 35, 53, 0.12);
    }

    /* El hilo crema de adentro */
    .arco::before {
        content: "";
        position: absolute;
        inset: 1cqw;
        border-radius: 50%;
        border: 1px solid rgba(176, 138, 62, 0.35);
        pointer-events: none;
    }

    /* Blanco con un toque perlado arriba, y el ícono en guindo */
    .arco {
        background-image: radial-gradient(
            circle at 50% 30%,
            #ffffff 0%,
            #fbf7f0 70%,
            #f3eadb 100%
        );
    }

    .icono {
        display: block;
        width: 7.4cqw;
        height: 7.4cqw;
        background-image: linear-gradient(#7a2335, #7a2335);
    }

    /* Un destello que cruza el arco una vez, al entrar */
    .brillo {
        position: absolute;
        top: -10%;
        bottom: -10%;
        left: 0;
        width: 45%;
        pointer-events: none;
        transform: translateX(-160%) skewX(-18deg);
        background-image: linear-gradient(
            90deg,
            rgba(255, 255, 255, 0) 0%,
            rgba(255, 236, 196, 0.6) 50%,
            rgba(255, 255, 255, 0) 100%
        );
    }

    /* ── Hora y nombre ─────────────────────────────────────────── */
    .hora {
        margin: 0;
        line-height: 1;
        white-space: nowrap;
    }

    .hora-num {
        font-family: "Cinzel", serif;
        font-weight: 400;
        font-size: 5cqw;
        letter-spacing: 0.08em;
        color: #4a3f3a;
    }

    .hora-suf {
        margin-left: 1cqw;
        font-family: "Cinzel", serif;
        font-weight: 500;
        font-size: 2.3cqw;
        letter-spacing: 0.2em;
        color: #b08a3e;
    }

    .filete {
        display: block;
        width: 11cqw;
        height: 1px;
        margin: 1.6cqw 0 1.2cqw;
    }

    .der .filete {
        margin-left: auto;
        background-image: linear-gradient(
            270deg,
            #b08a3e,
            rgba(176, 138, 62, 0)
        );
    }

    .izq .filete {
        background-image: linear-gradient(
            90deg,
            #b08a3e,
            rgba(176, 138, 62, 0)
        );
    }

    .nombre {
        margin: 0;
        color: #7a2335;
        font-size: 6.6cqw;
        line-height: 1.1;
    }

    /* Rombito final donde termina el eje */
    .remate {
        position: absolute;
        bottom: 4.6cqw;
        left: 50%;
        width: 2.2cqw;
        height: 2.2cqw;
        margin-left: -1.1cqw;
        transform: rotate(45deg);
        background-image: linear-gradient(#b08a3e, #b08a3e);
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("cronograma");
        const linea = document.getElementById("linea-tiempo");
        if (!seccion || !linea) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        // Encabezado: el subtítulo aparece y el título se "escribe" de
        // izquierda a derecha
        const encabezado = gsap.timeline({
            scrollTrigger: {
                trigger: seccion,
                start: "top 85%",
                toggleActions: "play none none reset",
            },
        });

        encabezado
            .fromTo(
                seccion.querySelector(".subtitulo"),
                { opacity: 0, letterSpacing: "0.6em" },
                {
                    opacity: 1,
                    letterSpacing: "0.32em",
                    duration: 1.2,
                    ease: "power2.out",
                },
            )
            .fromTo(
                seccion.querySelector(".titulo"),
                { clipPath: "inset(-30% 100% -30% -10%)" },
                {
                    clipPath: "inset(-30% -10% -30% -10%)",
                    duration: 1.6,
                    ease: "power1.inOut",
                },
                0.2,
            )
            .fromTo(
                seccion.querySelector(".separador"),
                { opacity: 0, scaleX: 0.3 },
                { opacity: 0.9, scaleX: 1, duration: 1, ease: "power2.out" },
                0.9,
            );

        // El eje se llena de luz al ritmo del scroll
        gsap.fromTo(
            linea.querySelector(".eje-luz"),
            { scaleY: 0 },
            {
                scaleY: 1,
                ease: "none",
                scrollTrigger: {
                    trigger: linea,
                    start: "top 70%",
                    end: "bottom 70%",
                    scrub: 0.6,
                },
            },
        );

        gsap.fromTo(
            linea.querySelector(".remate"),
            { opacity: 0, scale: 0, rotation: 45 },
            {
                opacity: 1,
                scale: 1,
                rotation: 45,
                duration: 0.6,
                ease: "back.out(2)",
                scrollTrigger: {
                    trigger: linea,
                    start: "bottom 72%",
                    toggleActions: "play none none reset",
                },
            },
        );

        // Cada momento entra cuando la luz del eje llega a su rombo
        const momentos = Array.from(linea.querySelectorAll(".momento"));

        momentos.forEach((momento) => {
            const textoALaIzquierda = momento.classList.contains("der");
            const desdeEje = textoALaIzquierda ? 1 : -1;

            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: momento,
                    start: "top 72%",
                    toggleActions: "play none none reverse",
                },
            });

            tl.fromTo(
                momento.querySelector(".rombo"),
                { scale: 0, rotation: 45 },
                {
                    scale: 1,
                    rotation: 45,
                    duration: 0.5,
                    ease: "back.out(3)",
                },
            )
                .fromTo(
                    momento.querySelector(".arco"),
                    { opacity: 0, y: 24, scale: 0.9 },
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 0.9,
                        ease: "power3.out",
                    },
                    0.1,
                )
                .fromTo(
                    momento.querySelector(".brillo"),
                    { xPercent: -160, skewX: -18 },
                    {
                        xPercent: 330,
                        skewX: -18,
                        duration: 1.1,
                        ease: "power2.inOut",
                    },
                    0.55,
                )
                .fromTo(
                    momento.querySelector(".hora"),
                    { opacity: 0, x: 18 * desdeEje },
                    { opacity: 1, x: 0, duration: 0.8, ease: "power3.out" },
                    0.2,
                )
                .fromTo(
                    momento.querySelector(".filete"),
                    { scaleX: 0 },
                    {
                        scaleX: 1,
                        transformOrigin: textoALaIzquierda
                            ? "100% 50%"
                            : "0% 50%",
                        duration: 0.7,
                        ease: "power2.out",
                    },
                    0.35,
                )
                .fromTo(
                    momento.querySelector(".nombre"),
                    {
                        clipPath: textoALaIzquierda
                            ? "inset(-30% -10% -30% 100%)"
                            : "inset(-30% 100% -30% -10%)",
                    },
                    {
                        clipPath: "inset(-30% -10% -30% -10%)",
                        duration: 1,
                        ease: "power1.inOut",
                    },
                    0.45,
                );
        });
    });
</script>
