---
// src/components/Historia.astro
// Franja de papel crema rasgada con el "Historia", la foto de los novios
// —también rasgada arriba y abajo— y el botón que abre la historia en una
// ventana sobre la invitación.
//
// El texto largo no se muestra de entrada: se lee en el modal. Así la
// sección queda liviana y quien quiera leerlo lo abre.
//
// Medidas del diseño, en % del ancho de la columna:
//   banda   22% de alto · foto 55% de alto

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Historia";
const foto = "/imagenes/foto2.webp";
const textoBoton = "Leer nuestra historia";
// El gancho va ARRIBA del botón: primero la pregunta, después el botón que
// la contesta. Y debajo, la instrucción, para que no quede ninguna duda.
const gancho = "¿Quieres saber cómo nos conocimos?";
// El anzuelo cuenta apenas lo justo para dar ganas de leer el resto
const anzuelo = "Todo empezó con un baile y una canción...";
const pista = "Toca el botón y te lo contamos";

const tituloModal = "Nuestra Historia";

const historia = [
    "Un 21 de abril de 2023, tuvimos la oportunidad de bailar juntos. Ambos éramos pasantes y, al compás de una melodía clásica que a los dos nos encantaba, sentimos una conexión intensa, como si el mundo se detuviera por un instante. Desde ese día, nuestras risas y charlas comenzaron a tejer un lazo invisible entre nosotros. Pasaron meses, seguimos caminos distintos, pero el destino nos volvió a reunir.",
    "El 7 de agosto de 2023, en un mirador donde la ciudad brillaba como un mar de luces. Con un pequeño peluche chancho en sus manos, símbolo de ternura y de cuánto me conoce, me pidió ser su novia. No dudé ni un segundo: lo miré a los ojos y dije que sí. Desde ese día, nuestro amor creció, acompañado por la calidez de su familia que me acogió como parte de ellos.",
    "Cada 21 de septiembre volvemos al lago, a nuestro refugio. Pero este 21 de septiembre de 2025 fue diferente. Frente al agua tranquila, me pidió un paso más: comprometernos para toda la vida. Volví a decir que sí, con la misma certeza de la primera vez, segura de que siempre fue él.",
    "Ese compromiso no es solo un anillo ni una promesa; es el inicio de una nueva etapa que queremos recorrer juntos. Él es mi refugio, mi destino, mi hogar. Este 21 de septiembre marcó el comienzo de nuestra historia más grande: la de dos almas que decidieron caminar juntas, con la certeza de que nuestro amor siempre encontrará su camino, hoy y siempre.",
];
// ──────────────────────────────────────────────────────────────
---

<section id="historia" class="seccion">
    <div id="banda-historia" class="banda">
        <h2 class="titulo font-elegant">{titulo}</h2>
    </div>

    <!-- La foto va a sangre y rasgada por arriba y por abajo -->
    <img
        id="foto-historia"
        src={foto}
        alt="Sebastián y Adriana tomados de la mano al atardecer"
        width="1280"
        height="853"
        class="foto"
    />

    <div id="pie-historia" class="pie">
        <p class="gancho font-elegant">{gancho}</p>
        <p class="anzuelo font-cormorant">{anzuelo}</p>

        <!--
           La flecha baja del texto al botón: primero la pregunta, después
           el camino, y al final lo que hay que tocar.
        -->
        <span class="flecha" aria-hidden="true">
            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M12 4v13"></path>
                <path d="M6 12l6 6 6-6"></path>
            </svg>
        </span>

        <button id="abrir-historia" type="button" class="boton font-cormorant">
            <svg
                class="icono-libro"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M12 7c-1.8-1.6-4-2.2-6.5-2.2H3v13h2.5c2.5 0 4.7.6 6.5 2.2"
                ></path>
                <path d="M12 7c1.8-1.6 4-2.2 6.5-2.2H21v13h-2.5c-2.5 0-4.7.6-6.5 2.2"
                ></path>
                <path d="M12 7v13"></path>
            </svg>
            <span>{textoBoton}</span>
        </button>

        <p class="pista font-cormorant">{pista}</p>
    </div>

    <!--
       La ventana con la historia. Va en un <dialog>: así el navegador se
       encarga del fondo oscuro, del foco y de cerrarla con Escape, sin
       tener que escribir nada de eso a mano.
    -->
    <dialog id="modal-historia" class="modal">
        <div class="hoja">
            <button
                id="cerrar-historia"
                type="button"
                class="cerrar"
                aria-label="Cerrar"
            >
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                >
                    <path d="M6 6l12 12M18 6L6 18"></path>
                </svg>
            </button>

            <!-- Solo esta parte scrollea; la hoja y sus flores no -->
            <div class="contenido">
                <h3 class="titulo-modal font-elegant">{tituloModal}</h3>

                <div class="relato font-cormorant">
                    {historia.map((parrafo) => <p>{parrafo}</p>)}
                </div>
            </div>
        </div>
    </dialog>
</section>

<style>
