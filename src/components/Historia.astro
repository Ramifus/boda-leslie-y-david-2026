    /* ── El pie ────────────────────────────────────────────── */
    .pie {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem 1.2rem 0;
        text-align: center;
    }

    /*
       La flecha que baja del texto al botón. Se hunde y vuelve: el ojo
       sigue el movimiento y termina justo donde hay que tocar.
    */
    .flecha {
        display: flex;
        margin: 0.5rem 0 0.7rem;
        color: #8a5a28;
        animation: bajar 1.6s ease-in-out infinite;
    }

    .flecha svg {
        width: clamp(1.5rem, 6.4vw, 1.8rem);
        height: clamp(1.5rem, 6.4vw, 1.8rem);
    }

    @keyframes bajar {
        0%,
        100% {
            transform: translateY(0);
            opacity: 0.75;
        }
        50% {
            transform: translateY(7px);
            opacity: 1;
        }
    }

    /*
       El mismo botón que el de la ceremonia —crema, versales, Cormorant—
       pero con las señales del de regalos: ícono, latido y la pista de
       abajo. Sin eso, un rectángulo quieto no se lee como algo para tocar.
    */
    .boton {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.6rem 1.6rem;
        border: 0;
        cursor: pointer;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        white-space: nowrap;
        color: #643e1a;
        background: #fbf5de;
        border-radius: 999px;
        font-size: clamp(1.05rem, 4.4vw, 1.2rem);
        line-height: 1.4;
        box-shadow: 0 5px 14px rgba(90, 65, 25, 0.16);
        animation: latido 2.6s ease-in-out infinite;
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease,
            background-color 0.25s ease;
    }

    @keyframes latido {
        0%,
        100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.045);
        }
    }

    .icono-libro {
        width: 1.15em;
        height: 1.15em;
        flex-shrink: 0;
    }

    .boton:hover {
        background: #fff9e8;
        box-shadow: 0 9px 20px rgba(90, 65, 25, 0.24);
    }

    /* Se hunde al tocarlo: la señal de que respondió */
    .boton:active {
        animation: none;
        transform: scale(0.97);
        box-shadow: 0 2px 6px rgba(90, 65, 25, 0.2);
    }

    /*
       La pregunta va en la caligrafía y grande: es la que engancha, así
       que tiene más peso que el propio botón.
    */
    .gancho {
        color: #643e1a;
        font-size: clamp(1.85rem, 8.4vw, 2.3rem);
        line-height: 1.35;
    }

    /* Un renglón chico y en itálica: se lee como un secreto a medias */
    .anzuelo {
        margin-top: 0.4rem;
        color: #8a5a28;
        font-style: italic;
        font-size: clamp(1.05rem, 4.6vw, 1.2rem);
        line-height: 1.4;
    }

    .pista {
        margin-top: 0.6rem;
        color: #643e1a;
        font-size: clamp(1.05rem, 4.6vw, 1.2rem);
        line-height: 1.4;
    }

    /* ── La ventana de la historia ─────────────────────────── */
    /*
       inset 0 + margin auto es lo que la centra. El navegador ya lo hace
       por su cuenta con showModal(), pero dejarlo escrito evita que se
       vaya a una esquina si algún estilo de arriba le pisa el margen.
    */
    .modal {
        position: fixed;
        inset: 0;
        margin: auto;
        width: min(92vw, 26rem);
        max-height: 86vh;
        padding: 0;
        border: 0;
        background: transparent;
        overflow: visible;
    }

    .modal::backdrop {
        background: rgba(60, 40, 15, 0.55);
        backdrop-filter: blur(2px);
    }

    /* La hoja de papel: el mismo fondo y los mismos colores de la invitación */
    .hoja {
        position: relative;
        max-height: 86vh;
        overflow: hidden;
        background: #f7f3d3;
        border-radius: 12px;
        box-shadow: 0 18px 40px rgba(40, 25, 10, 0.35);
    }

    /*
       Lo único que scrollea es el texto. overscroll-behavior: contain
       corta el "encadenado": al llegar al final del relato, la rueda deja
       de pasarle el movimiento a la página de atrás.
    */
    .contenido {
        position: relative;
        z-index: 1;
        max-height: 86vh;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: 2.2rem 1.6rem 2.4rem;
    }


    /*
       z-index 2 y no auto: el bloque del texto va con z-index 1 y le
       quedaba encima, así que se comía los clics de la X y la ventana no
       cerraba por más que el botón estuviera a la vista.
    */
    .cerrar {
        position: absolute;
        z-index: 2;
        top: 0.7rem;
        right: 0.7rem;
        width: 2rem;
        height: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 0;
        border-radius: 999px;
        cursor: pointer;
        color: #643e1a;
        background: rgba(100, 62, 26, 0.1);
        transition: background-color 0.25s ease;
    }

    .cerrar svg {
        width: 1.05rem;
        height: 1.05rem;
    }

    .cerrar:hover {
        background: rgba(100, 62, 26, 0.2);
    }

    .titulo-modal {
        margin-bottom: 1.2rem;
        text-align: center;
        color: #643e1a;
        font-size: clamp(1.6rem, 7.4vw, 2rem);
        line-height: 1.2;
    }

    .relato {
        color: #643e1a;
        font-size: clamp(1.05rem, 4.4vw, 1.15rem);
        line-height: 1.7;
        text-align: justify;
    }

    /* El aire entre párrafos, no antes del primero */
    .relato p + p {
        margin-top: 1rem;
    }

    /* Quien pide menos movimiento no ve ni el latido ni la flecha bajar */
    @media (prefers-reduced-motion: reduce) {
        .boton,
        .flecha {
            animation: none;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        // ── La ventana ──────────────────────────────────────────
        const modal = document.getElementById(
            "modal-historia",
        ) as HTMLDialogElement | null;
        const abrir = document.getElementById("abrir-historia");
        const cerrar = document.getElementById("cerrar-historia");

        /*
           Mientras la ventana está abierta se traba el scroll de la
           página: el navegador no lo hace solo.

           Y se traba en el <html>, no solo en el <body>: el layout le
           puso overflow-x: hidden al html, y con eso deja de valer la
           regla por la que el overflow del body gobierna la ventana. Si
           solo se tocara el body, la página seguiría corriéndose detrás.
        */
        const raiz = document.documentElement;

        abrir?.addEventListener("click", () => {
            modal?.showModal();
            raiz.style.overflow = "hidden";
            document.body.style.overflow = "hidden";
        });

        const cerrarVentana = () => {
            modal?.close();
        };

        cerrar?.addEventListener("click", cerrarVentana);

        // Clic afuera de la hoja: también cierra
        modal?.addEventListener("click", (e) => {
            if (e.target === modal) cerrarVentana();
        });

        // Un solo lugar donde se devuelve el scroll: así también vale
        // cuando se cierra con la tecla Escape.
        modal?.addEventListener("close", () => {
            raiz.style.overflow = "";
            document.body.style.overflow = "";
        });

        // ── Entrada ─────────────────────────────────────────────
        const banda = document.getElementById("banda-historia");
        const foto = document.getElementById("foto-historia");
        const pie = document.getElementById("pie-historia");

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        if (banda) {
            gsap.fromTo(
                banda.querySelector(".titulo"),
                { opacity: 0, y: 16 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 1,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: banda,
                        start: "top 85%",
                        toggleActions: "play none none reset",
                    },
                },
            );
        }

        // La foto arranca ampliada y se acomoda, como en Foto1
        if (foto) {
            gsap.fromTo(
                foto,
                { scale: 1.12 },
                {
                    scale: 1,
                    duration: 2.2,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: foto,
                        start: "top 88%",
                        toggleActions: "play none none reset",
                    },
                },
            );
        }

        if (pie) {
            gsap.fromTo(
                pie.children,
                { opacity: 0, y: 16 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.7,
                    stagger: 0.14,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: pie,
                        start: "top 90%",
                        toggleActions: "play none none reset",
                    },
                },
            );
        }
    });
</script>
