---
// src/components/Confirmar.astro
// La foto de los novios rasgada arriba y abajo, la franja de papel con el
// saludo, el pedido de confirmación con su botón, el pase y el cierre con
// el monograma dentro de la guirnalda.
//
// Medidas del diseño, en % del ancho de la columna:
//   banda   27% de alto · botón 75% de ancho

/*
   Cuántos lugares reserva la invitación. Se pasa desde Invitacion.astro
   —<Confirmar pases={2} />— para no tener que venir a editar acá adentro
   cada vez que cambia el pase de un invitado.

   En 0 (o sin pasar nada) la invitación va SIN pase: no se dibuja la
   barrita. Es la del index, la que se comparte en un grupo.
*/
export interface Props {
    pases?: number;
}
const { pases = 0 } = Astro.props;

// ── DATOS EDITABLES ───────────────────────────────────────────
const foto = "/imagenes/foto3.webp";
const titulo = "Querida Familia Y Amigos";

const parrafos = [
    "Nos llena de felicidad poder compartir con ustedes este momento tan especial.",
    "Con la esperanza de que hagamos de este día un recuerdo inolvidable.",
    "Los esperamos con los corazones llenos de emoción, listos para celebrar con amor y crear memorias que permanezcan por siempre.",
];

const textoBoton = "Confirmar asistencia";
const cierre = "Te esperamos";
const monograma = "S & A";

/*
   El botón abre WhatsApp con el mensaje ya escrito. El número va con el
   código de país y sin el + ni espacios, que es como lo pide wa.me.
   Los nombres y la fecha salen de estas mismas constantes, así que si
   alguna cambia, el mensaje se actualiza solo.
*/
const telefono = "59161006490";
const novios = "Sebastián y Adriana";
const fechaBoda = "19 de septiembre de 2026";
const mensaje = `Me complace confirmar mi asistencia a la boda de ${novios}, el ${fechaBoda}.`;
const enlaceConfirmar = `https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`;

/*
   El pase se arma solo con el número que llega por props: 1 da "Pase para
   una persona" y 2 "Pase para dos personas". Si hiciera falta un número
   más alto que los de la lista, cae al dígito ("Pase para 12 personas").
   En 0 queda en null y más abajo no se dibuja nada.
*/
const enLetras = [
    "", // el 0 no se usa: está para que el 1 caiga en "una"
    "una",
    "dos",
    "tres",
    "cuatro",
    "cinco",
    "seis",
    "siete",
    "ocho",
    "nueve",
    "diez",
];
const cantidad = enLetras[pases] ?? String(pases);
const pase =
    pases > 0
        ? `Pase para ${cantidad} ${pases === 1 ? "persona" : "personas"}`
        : null;
// ──────────────────────────────────────────────────────────────
---

<section id="confirmar" class="seccion">
    <!-- La foto va a sangre y rasgada arriba y abajo -->
    <img
        id="foto-confirmar"
        src={foto}
        alt="Sebastián y Adriana de la mano"
        class="foto"
    />

    <div id="banda-confirmar" class="banda">
        <h2 class="titulo font-elegant">{titulo}</h2>
    </div>

    <div id="cuerpo-confirmar" class="cuerpo">
        <div class="parrafos font-cormorant">
            {parrafos.map((p) => <p>{p}</p>)}
        </div>

        <a
            class="boton font-cormorant"
            href={enlaceConfirmar}
            target="_blank"
            rel="noopener noreferrer"
        >
            {textoBoton}
        </a>

        {pase && <p class="pase font-cormorant">{pase}</p>}

        <p class="cierre font-cormorant">{cierre}</p>
    </div>

    <!--
       La guirnalda va montada sobre una tira de papel angosta: la tira le
       llega a poco más de la mitad y la corona se sale por arriba y por
       abajo, como en el diseño.
    -->
    <div id="zona-monograma" class="zona-monograma">
        <div class="banda-monograma" aria-hidden="true"></div>

        <div class="monograma">
            <img
                src="/imagenes/guirnalda2.png"
                alt=""
                aria-hidden="true"
                class="guirnalda"
            />
            <span class="iniciales font-elegant">{monograma}</span>
        </div>
    </div>
</section>

