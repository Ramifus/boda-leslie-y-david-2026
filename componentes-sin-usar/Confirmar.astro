    /* Mismo tamaño y color que los otros títulos de la invitación */
    .titulo {
        margin: 0 auto;
        text-align: center;
        color: #643e1a;
        font-size: clamp(2.35rem, 10.7vw, 2.9rem);
        line-height: 1.25;
    }

    /* ── El cuerpo ─────────────────────────────────────────── */
    .cuerpo {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2.2rem 1.4rem 0;
        text-align: center;
    }

    .parrafos {
        color: #643e1a;
        font-size: clamp(1.1rem, 4.8vw, 1.25rem);
        line-height: 1.6;
    }

    /* El aire entre párrafos, no antes del primero */
    .parrafos p + p {
        margin-top: 1.1rem;
    }

    /*
       El botón macizo del diseño: marrón oscuro, ancho, con las letras
       separadas. Es la acción principal de toda la invitación.
    */
    .boton {
        display: inline-block;
        width: 75%;
        max-width: 20rem;
        box-sizing: border-box;
        margin-top: 2rem;
        padding: 0.7rem 1rem;
        text-align: center;
        text-decoration: none;
        text-transform: uppercase;
        /*
           Letras juntas y cuerpo contenido: "CONFIRMAR ASISTENCIA" son 20
           caracteres y con más espaciado se salía de la barra.
        */
        letter-spacing: 0.04em;
        color: #fdf8e6;
        background: #6b4e14;
        border-radius: 8px;
        font-size: clamp(0.95rem, 4.1vw, 1.1rem);
        line-height: 1.4;
        box-shadow: 0 6px 16px rgba(107, 78, 20, 0.3);
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease,
            background-color 0.25s ease;
    }

    .boton:hover {
        background: #7d5c1c;
        box-shadow: 0 9px 20px rgba(107, 78, 20, 0.42);
    }

    .boton:active {
        transform: scale(0.98);
        box-shadow: 0 3px 8px rgba(107, 78, 20, 0.3);
    }

    /* El pase: la misma barra pero más angosta y sin versales */
    .pase {
        display: inline-block;
        margin-top: 0.7rem;
        padding: 0.5rem 1.6rem;
        color: #fdf8e6;
        background: #6b4e14;
        border-radius: 8px;
        font-size: clamp(1rem, 4.4vw, 1.15rem);
        line-height: 1.4;
    }

    .cierre {
        margin-top: 2.2rem;
        color: #643e1a;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        font-size: clamp(1.15rem, 5vw, 1.35rem);
        line-height: 1.3;
    }

    /* ── El monograma ──────────────────────────────────────── */
    /*
       Su propia franja de papel, rasgada arriba y abajo, como en el
       diseño: la guirnalda no se apoya sobre el fondo sino sobre el papel.
    */
    /*
       La zona lleva proporción fija (alto = la mitad del ancho) para que
       los porcentajes de adentro tengan contra qué medirse: sin un alto
       definido, el alto en % de la tira no resolvería.
    */
    .zona-monograma {
        position: relative;
        width: 100%;
        margin-top: 1.4rem;
        aspect-ratio: 100 / 50;
    }

