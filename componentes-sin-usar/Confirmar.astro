<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const banda = document.getElementById("banda-confirmar");
        const cuerpo = document.getElementById("cuerpo-confirmar");
        const foto = document.getElementById("foto-confirmar");
        if (!banda || !cuerpo) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        /*
           La foto arranca ampliada y se va acomodando hasta su tamaño,
           igual que en las otras secciones.

           El toggleActions termina en "none" y no en "reset" a propósito:
           con reset, al volver a subir la foto quedaba otra vez al 112% y
           se veía recortada. Así, una vez que llegó a su tamaño, se queda
           entera.
        */
        if (foto) {
            gsap.fromTo(
                foto,
                { scale: 1.12, opacity: 0 },
                {
                    scale: 1,
                    opacity: 1,
                    duration: 2.2,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: foto,
                        start: "top 92%",
                        toggleActions: "play none none none",
                    },
                },
            );
        }

        gsap.fromTo(
            banda.querySelector(".titulo"),
            { opacity: 0, y: 16 },
            {
                opacity: 1,
                y: 0,
                duration: 1,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: banda,
                    start: "top 85%",
                    toggleActions: "play none none reset",
                },
            },
        );

        gsap.fromTo(
            [
                ...cuerpo.querySelectorAll(".parrafos p"),
                cuerpo.querySelector(".boton"),
                cuerpo.querySelector(".pase"),
                cuerpo.querySelector(".cierre"),
            ].filter(Boolean),
            { opacity: 0, y: 16 },
            {
                opacity: 1,
                y: 0,
                duration: 0.7,
                stagger: 0.11,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: cuerpo,
                    start: "top 88%",
                    toggleActions: "play none none reset",
                },
            },
        );

        /*
           El monograma solo se desvanece: NO se le puede animar la
           posición, porque va centrado con un translate y GSAP escribiría
           su propio transform encima, corriéndolo de la tira de papel.
        */
        const zona = document.getElementById("zona-monograma");
        if (zona) {
            gsap.fromTo(
                zona.children,
                { opacity: 0 },
                {
                    opacity: 1,
                    duration: 0.9,
                    stagger: 0.15,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: zona,
                        start: "top 92%",
                        toggleActions: "play none none reset",
                    },
                },
            );
        }
    });
</script>
